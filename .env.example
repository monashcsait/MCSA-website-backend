# Optional systemd settings: copy needed values to /etc/mcsa-backend.env.
# This file is not automatically loaded by Python.
# Domains are normally configured in deployment.json instead.

# Extra public frontend origins, comma-separated. Do not include repository paths.
# MCSA_ALLOWED_ORIGINS=https://YOUR-ACCOUNT.github.io,https://www.example.org

# Optional English translation service. Keep the actual key on the server.
# AZURE_TRANSLATOR_KEY=your-own-key
# AZURE_TRANSLATOR_REGION=your-resource-region
